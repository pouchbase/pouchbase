{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["svelte", "@pouchbasejs/plugin-sdk/env"],
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true
	},
	"include": ["**/*.ts", "**/*.svelte"],
	"exclude": ["node_modules", "dist"]
}
