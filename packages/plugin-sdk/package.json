{
	"name": "@pouchbasejs/plugin-sdk",
	"version": "0.4.0",
	"description": "Types, manifest schema and CLI for building Pouchbase plugins",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pouchbase/pouchbase.git",
		"directory": "packages/plugin-sdk"
	},
	"homepage": "https://pouchbase.io",
	"keywords": [
		"pouchbase",
		"plugin",
		"sdk"
	],
	"sideEffects": false,
	"bin": {
		"pouchbase-plugin": "./dist/cli.js"
	},
	"files": [
		"dist",
		"env.d.ts"
	],
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server.ts",
		"./ui": "./src/ui.ts",
		"./project": "./src/project.ts",
		"./testing": "./src/testing.ts",
		"./vite": "./src/vite.ts",
		"./env": {
			"types": "./env.d.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./server": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			},
			"./ui": {
				"types": "./dist/ui.d.ts",
				"default": "./dist/ui.js"
			},
			"./project": {
				"types": "./dist/project.d.ts",
				"default": "./dist/project.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./env": {
				"types": "./env.d.ts"
			},
			"./package.json": "./package.json"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@iconify-json/lucide": "^1.2.147",
		"@pouchbasejs/js-sdk": "workspace:^",
		"es-module-lexer": "^2.3.2",
		"rolldown": "^1.2.15",
		"semver": "^7.8.5",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/semver": "^7.7.1",
		"tsdown": "^0.23.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
